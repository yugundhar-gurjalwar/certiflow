# Copy to .env to override docker-compose defaults. Never commit the real .env.
JWT_SECRET=change-me-in-production-please-32chars
CERT_NUMBER_SECRET=change-me-too-in-production-32chars
WEBHOOK_SECRET=change-me-webhook-secret
PUBLIC_WEB_URL=http://localhost:8080
DEMO_MODE=true
DEMO_PASSWORD=demo1234
# Shorten for the escalation demo (minutes a batch may wait before seniors are told)
ESCALATION_LEVEL1_MINUTES=1440
ESCALATION_LEVEL2_MINUTES=2880
